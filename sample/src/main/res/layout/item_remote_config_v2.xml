<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/contextKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorBlack"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="e2e_simple_flag" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rc_v2_source"
                android:textColor="@color/colorGrayText"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Server" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rc_v2_apply_policy"
                android:textColor="@color/colorGrayText"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/applyPolicy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="@color/colorBlack"
                android:textSize="12sp"
                tools:text="OnNextActivate" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rc_v2_variation"
                android:textColor="@color/colorGrayText"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/variationUid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="@color/colorBlack"
                android:textSize="12sp"
                tools:text="default-e2e-simple-flag" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rc_v2_value"
            android:textColor="@color/colorGrayText"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rawValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/colorLightGray"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="@color/colorBlack"
            android:textSize="11sp"
            tools:text="{&quot;enabled&quot;: true}" />

        <TextView
            android:id="@+id/metadataLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rc_v2_metadata"
            android:textColor="@color/colorGrayText"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/metadataJson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/colorLightGray"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="@color/colorBlack"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="{&quot;experiment&quot;: {&quot;name&quot;: &quot;extendedFreeV1&quot;}}" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
